# Copy this file to .env and fill in real values:   cp .env.example .env
# Then lock it down:                                 chmod 600 .env
# NEVER commit .env — it contains database passwords.
#
# Passwords go on their own line, exactly as-is. No encoding, no quotes needed
# unless the value contains spaces (then wrap it: AML_READ_PWD="my pass word").

# ---- READ side: the Finacle replica (source of transactions) ----
export AML_READ_USER=RSVR_P_SQLACC_R_DS
export AML_READ_PWD=your_read_password_here
export AML_READ_HOST=PUGSQLRSVRAG02.ug.sbicdirectory.com
export AML_READ_PORT=5200
export AML_READ_DB=RSVRRealtimeFinacleUGPRD

# ---- WRITE side: the reporting DB (where results land) ----
export AML_WRITE_USER=your_write_user
export AML_WRITE_PWD=your_write_password_here
export AML_WRITE_HOST=REPORTHOST
export AML_WRITE_PORT=1433
export AML_WRITE_DB=AML_Reporting

# ---- ODBC driver name (must match `odbcinst -q -d` on this box) ----
export AML_ODBC_DRIVER=ODBC Driver 17 for SQL Server
